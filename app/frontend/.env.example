# Copy this file to .env before building, and set VITE_API_BASE_URL to your
# Spring Boot backend's base URL. This app has no demo/mock-data mode: it
# will not run without a real backend to talk to (see BackendNotConfigured
# screen in src/App.tsx). The backend's context-path is /api by default
# (see backend/src/main/resources/application.yml).

VITE_API_BASE_URL=http://localhost:8080/api

# Optional — overrides the studio name shown across the site/portal/admin.
# Defaults to "Cameraman Photo Studio" if unset.
# VITE_STUDIO_NAME=Your Studio Name
