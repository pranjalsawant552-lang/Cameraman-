# ============================================================
# Cameraman Photo Studio - Environment Variables
# Copy this file to .env and fill in the values
# ============================================================

# Spring Profile
SPRING_PROFILE=prod

# Database
DB_URL=jdbc:postgresql://localhost:5432/cameraman_db
DB_USERNAME=cameraman
DB_PASSWORD=your_secure_db_password

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password

# JWT (generate a secure 256-bit base64 encoded secret)
# Generate: openssl rand -base64 32
JWT_SECRET=your_base64_encoded_jwt_secret_minimum_32_chars

# Mail (SMTP)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=noreply@yourstudio.com
MAIL_PASSWORD=your_app_password

# Storage (Cloudflare R2 or AWS S3)
STORAGE_TYPE=s3
S3_ENDPOINT=https://your-account.r2.cloudflarestorage.com
S3_BUCKET=cameraman-photos
S3_REGION=auto
S3_ACCESS_KEY=your_access_key
S3_SECRET_KEY=your_secret_key
# Public delivery domain for the bucket — NOT the same as S3_ENDPOINT above (that's the
# authenticated API endpoint; R2 requires SigV4 auth on it even for GETs). Enable "Public
# access" on the bucket in the R2 dashboard to get a pub-<hash>.r2.dev domain, or use a
# custom domain connected through Cloudflare. Only needed for genuinely-public assets
# (inventory QR codes, WhatsApp broadcast media) — leave blank if you're not using those.
S3_PUBLIC_BASE_URL=https://pub-your-hash.r2.dev
# Only when the backend can't reach storage at the same address the browser uses
# (MinIO in Docker). Leave blank for AWS S3 / iDrive e2 / R2.
S3_PRESIGN_ENDPOINT=
# true for MinIO / e2 / R2; false for AWS S3 virtual-hosted style.
S3_PATH_STYLE=true

# Razorpay
RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret

# WhatsApp Business API (Meta)
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id
WHATSAPP_ACCESS_TOKEN=your_whatsapp_access_token
WHATSAPP_VERIFY_TOKEN=your_webhook_verify_token

# Google Drive bulk-import (staff-only; not used for client-facing galleries)
GOOGLE_DRIVE_API_KEY=your_google_drive_api_key

# Application
APP_BASE_URL=https://cameraman.com
API_BASE_URL=https://cameraman.com/api
SERVER_PORT=8080

# CORS — comma-separated, exact origins only (no wildcards). Must include
# every real frontend domain (staff dashboard + client portal, and any
# staging URLs) or browsers will block requests with a CORS error.
CORS_ALLOWED_ORIGINS=https://app.cameraman.com,https://portal.cameraman.com

# GST
GST_NUMBER=27AAAAA0000A1Z5
