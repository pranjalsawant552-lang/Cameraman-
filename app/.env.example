# ============================================================
# Copy to .env  (cp .env.example .env).  Every value is optional for the
# default local MinIO setup — `docker compose up --build` works with no .env.
# ============================================================

DB_PASSWORD=replace_with_secure_password
# JWT_SECRET=<base64, 32+ bytes>  -> openssl rand -base64 32   (set a real one before going live)

# ------------------------------------------------------------
# STORAGE — pick ONE block. Default = local MinIO (already active below).
# ------------------------------------------------------------

# --- A) Local MinIO (default; no accounts needed) -----------------------------
S3_ENDPOINT=http://minio:9000
S3_PRESIGN_ENDPOINT=http://localhost:9000
S3_PUBLIC_BASE_URL=http://localhost:9000/cameraman-photos
S3_BUCKET=cameraman-photos
S3_REGION=us-east-1
S3_ACCESS_KEY=replace_with_minio_access_key
S3_SECRET_KEY=replace_with_minio_secret_key
S3_PATH_STYLE=true

# --- B) AWS S3 (when you get keys) --------------------------------------------
# Comment out block A and use this. Create the bucket first (ap-south-1 = Mumbai).
# S3_ENDPOINT=https://s3.ap-south-1.amazonaws.com
# S3_PRESIGN_ENDPOINT=
# S3_PUBLIC_BASE_URL=            # CloudFront / bucket URL, only for public QR + WhatsApp media
# S3_BUCKET=your-bucket-name
# S3_REGION=ap-south-1
# S3_ACCESS_KEY=AKIA...
# S3_SECRET_KEY=...
# S3_PATH_STYLE=false            # virtual-hosted style is the AWS default

# --- C) iDrive e2 (when you get keys) -----------------------------------------
# Endpoint + region are shown in the e2 console for your bucket's region.
# S3_ENDPOINT=https://<your-region-endpoint>.idrivee2-XX.com
# S3_PRESIGN_ENDPOINT=
# S3_PUBLIC_BASE_URL=            # only if you enable public access / custom domain
# S3_BUCKET=your-bucket-name
# S3_REGION=<region from console, e.g. us-east-1>
# S3_ACCESS_KEY=...
# S3_SECRET_KEY=...
# S3_PATH_STYLE=true

# ------------------------------------------------------------
# Optional integrations (leave blank; features show "not configured")
# ------------------------------------------------------------
# MAIL_HOST=smtp.gmail.com
# MAIL_USERNAME=
# MAIL_PASSWORD=
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_ACCESS_TOKEN=
# GOOGLE_DRIVE_API_KEY=

# Google Drive as PRIVATE storage for full-resolution originals (see STORAGE.md). Leave blank to keep
# originals on S3. Folder id = the last part of the Drive folder URL. Give ONE auth method:
# GDRIVE_ROOT_FOLDER_ID=
# GDRIVE_OAUTH_CLIENT_ID=
# GDRIVE_OAUTH_CLIENT_SECRET=
# GDRIVE_OAUTH_REFRESH_TOKEN=
# GDRIVE_SERVICE_ACCOUNT_JSON=      # needs a Shared Drive
# STORAGE_ORIGINALS=auto            # auto | gdrive | s3
# VITE_STUDIO_NAME=Your Studio Name

# Attendance machines (ADMS push): serial numbers allowed to push without a key.
# Find the serial in the machine menu (System / Device Info) or on its label.
# ATTENDANCE_ALLOWED_SERIALS=CKWD123456789,CKWD987654321
